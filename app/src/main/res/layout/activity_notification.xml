<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Activité 8 : Notifications"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnToastCourt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Afficher Toast léger" />

    <Button
        android:id="@+id/btnToastLong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Afficher Toast dure" />

    <Button
        android:id="@+id/btnDialog1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Afficher boite de dialogue 1" />

    <Button
        android:id="@+id/btnDialog2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Afficher boite de dialogue 2" />

    <Button
        android:id="@+id/btnDialog3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Afficher boite de dialogue 3" />

    <Button
        android:id="@+id/btnRetourNotif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Retour au Menu" />

</LinearLayout>